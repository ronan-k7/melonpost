# Brand and canonical domain
NEXT_PUBLIC_SITE_NAME="Melonpost"
# Must be the exact address people reach the site on (this one is www). Every canonical,
# sitemap URL, og:image and JSON-LD URL is built from it - if it differs from the live
# domain (or the live domain redirects to another one) social crawlers can drop the card.
NEXT_PUBLIC_SITE_URL="https://www.melonpost.org"
NEXT_PUBLIC_SITE_TAGLINE="Independent journalism. Global perspectives."
NEXT_PUBLIC_SITE_EDITION="International"
NEXT_PUBLIC_SITE_CITY="London, UK"
NEXT_PUBLIC_SITE_WEATHER="16°C"
NEXT_PUBLIC_CONTACT_EMAIL="desk@melonpost.org"

# Publication social accounts
NEXT_PUBLIC_X_URL="https://x.com/melonpost"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/melonpost"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/melonpost"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@melonpost"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/melonpost"

# Optional newsletter provider landing page. Leave blank for the built-in demo state.
NEXT_PUBLIC_NEWSLETTER_URL=""

# Optional search-engine ownership meta tags (Search Console / Bing Webmaster Tools).
# The google4720de8dcf704056.html file in /public already verifies Google; these are extra.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
